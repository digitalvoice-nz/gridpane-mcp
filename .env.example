GRIDPANE_API_TOKEN=your_api_token_here
GRIDPANE_API_URL=https://my.gridpane.com/oauth/api/v1
# Set to 1 to let the MCP run_wp_cli tool run commands outside the read-only allowlist.
GRIDPANE_WP_CLI_ALLOW_WRITE=0
# Optional GP-CLI over SSH backend (root SSH to your GridPane servers). Off unless 1.
GRIDPANE_SSH_ENABLE=0
GRIDPANE_SSH_KEY=
GRIDPANE_SSH_USER=root
GRIDPANE_SSH_PORT=22
